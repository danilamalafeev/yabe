{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-obsidian",
        "/Users/danilamalafeev/Documents/SECOND_BRAIN/SECOND_BRAIN"
      ],
      "enabled": true
    },
    "jupyter": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-jupyter"
      ],
      "enabled": true
    },
    "ripgrep": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-ripgrep"
      ],
      "enabled": true
    },
    "ast-grep": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "ast-grep-mcp"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-fetch-server"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/danilamalafeev/Documents/SECOND_BRAIN",
        "/Users/danilamalafeev/Documents/YABE",
        "/Users/danilamalafeev/Documents/Adversarial RL in price wars"
      ],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git",
        "--repository",
        "/Users/danilamalafeev/Documents/YABE",
        "--repository",
        "/Users/danilamalafeev/Documents/Adversarial RL in price wars"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    },
    "arxiv": {
      "type": "local",
      "command": [
        "uvx",
        "arxiv-mcp-server"
      ],
      "enabled": true
    },
    "semantic-scholar": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@xbghc/semanticscholar-mcp"
      ],
      "enabled": true
    },
    "pdf-reader": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "pdf-mcp"
      ],
      "enabled": true
    },
    "markitdown": {
      "type": "local",
      "command": [
        "uvx",
        "markitdown-mcp"
      ],
      "enabled": true
    },
    "wolfram": {
      "type": "remote",
      "url": "https://agenttools.wolfram.com/mcp",
      "enabled": true
    },
    "puppeteer": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "puppeteer-mcp-server"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN_HERE"
      }
    }
  }
}
